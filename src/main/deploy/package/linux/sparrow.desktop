[Desktop Entry]
Name=Sparrow BLAKE2b
Comment=Sparrow (BLAKE2b) Wallet
Exec=/opt/sparrowwallet-blake2b/bin/sparrow %U
Icon=/opt/sparrowwallet-blake2b/lib/sparrow.png
Terminal=false
Type=Application
Categories=Finance;Network;
MimeType=application/psbt;application/bitcoin-transaction;application/pgp-signature;x-scheme-handler/bitcoin;x-scheme-handler/auth47;x-scheme-handler/lightning
SingleMainWindow=true
