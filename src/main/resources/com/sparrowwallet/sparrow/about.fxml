<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import com.sparrowwallet.sparrow.control.DialogImage?>

<StackPane prefHeight="520.0" prefWidth="600.0" stylesheets="@about.css, @general.css" fx:controller="com.sparrowwallet.sparrow.AboutController" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml">
    <VBox spacing="20">
        <HBox styleClass="title-area">
            <HBox alignment="CENTER_LEFT">
                <Label fx:id="title" text="Sparrow" styleClass="title-label" />
            </HBox>
            <Region HBox.hgrow="ALWAYS"/>
            <DialogImage fx:id="dialogImage" type="SPARROW" AnchorPane.rightAnchor="0"/>
        </HBox>
        <VBox spacing="10" styleClass="content-area">
            <Label text="Sparrow is a Bitcoin wallet with the goal of providing greater transparency and usability on the path to full financial self-sovereignty. It attempts to provide all of the detail about your wallet setup, transactions and UTXOs so that you can transact with a full understanding of your money." wrapText="true" />
            <Label text="This build follows the BLAKE2b chain, which changed its proof of work at block 961,640. Coins created before then also exist on the SHA256d chain, and an ordinary transaction is valid on both, so this build shows whether each transaction is replay protected. It refuses a server on the SHA256d chain." wrapText="true" />
            <Label text="It connects only to a server of your own: a BLAKE2b node directly, or an Electrum server backed by one. In the offline mode it is useful as a transaction editor and as an airgapped multisig coordinator." wrapText="true" />
            <HBox><Label text="Source, documentation and bug reports: "/><Hyperlink text="github.com/paulscode/sparrow" onAction="#openRepository"/></HBox>
            <Label text="Releases are signed with key FF76 D484 3EBD 7FA0 6D92 DC0C B8AB 7B8E 7E28 0E1A." wrapText="true" />
            <HBox><Label text="Based on upstream Sparrow, by Craig Raw. To support it: "/><Hyperlink text="sparrowwallet.com/donate" onAction="#openDonate"/></HBox>
        </VBox>
        <HBox styleClass="button-area" alignment="BOTTOM_RIGHT" VBox.vgrow="SOMETIMES">
            <Button text="Close" onAction="#close" />
        </HBox>
    </VBox>
</StackPane>
